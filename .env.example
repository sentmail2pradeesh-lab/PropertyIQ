# Copy to backend/.env and adjust. Never commit the real .env.
PROPERTYIQ_ENVIRONMENT=local

# Uploads
PROPERTYIQ_MAX_UPLOAD_MB=25
PROPERTYIQ_MAX_IMAGE_PIXELS=60000000

# Quality thresholds (will be tuned against a labelled set in milestone 4)
PROPERTYIQ_ANALYSIS_MAX_SIDE_PX=1024
PROPERTYIQ_BLUR_THRESHOLD=100
PROPERTYIQ_UNDEREXPOSED_MEAN=70
PROPERTYIQ_OVEREXPOSED_MEAN=190
PROPERTYIQ_CLIPPING_WARN_PCT=5

# JSON list
PROPERTYIQ_CORS_ORIGINS=["http://localhost:5173"]

# --- Added in later milestones (leave blank for now) ---
# PROPERTYIQ_GEMINI_API_KEY=
# PROPERTYIQ_DATABASE_URL=postgresql+psycopg://propertyiq:propertyiq@localhost:5432/propertyiq
# PROPERTYIQ_REDIS_URL=redis://localhost:6379/0
# PROPERTYIQ_S3_ENDPOINT=http://localhost:9000
